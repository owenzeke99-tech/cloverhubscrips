---------------------------------------------------------
-- HIỆU ỨNG LẮC & XỬ LÝ SỰ KIỆN
---------------------------------------------------------

local function shakeMenu()
    InputStroke.Color = Color3.fromRGB(255, 60, 60)
    MainStroke.Color = Color3.fromRGB(255, 60, 60)
    KeyInput.Text = ""
    
    local offsets = { -12, 12, -8, 8, -4, 4, 0 }
    for _, offset in ipairs(offsets) do
        local targetPos = UDim2.new(0.5, -190 + offset, 0.5, -120)
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.04, Enum.EasingStyle.Linear), {Position = targetPos})
        tween:Play()
        tween.Completed:Wait()
    end
    
    task.wait(0.5)
    TweenService:Create(InputStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(38, 38, 48)}):Play()
    TweenService:Create(MainStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(0, 230, 118)}):Play()
end

SubmitBtn.MouseButton1Click:Connect(function()
    if KeyInput.Text == CORRECT_KEY then
        -- Lưu file ngầm trong 24h
        saveKeyData(KeyInput.Text)
        
        SubmitBtn.Text = "SUCCESS!"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 230, 118)
        
        -- Gọi tải script chính
        loadMainScript()
        
        task.wait(0.8)
        
        local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        })
        closeTween:Play()
        closeTween.Completed:Wait()
        ScreenGui:Destroy()
    else
        SubmitBtn.Text = "INVALID KEY!"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
        SubmitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        task.spawn(shakeMenu)
        
        task.wait(1.2)
        SubmitBtn.Text = "VERIFY KEY"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 230, 118)
        SubmitBtn.TextColor3 = Color3.fromRGB(10, 12, 10)
    end
end)

GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GET_KEY_LINK)
        GetKeyBtn.Text = "LINK COPIED TO CLIPBOARD!"
        task.wait(1.5)
        GetKeyBtn.Text = "GET KEY (COPY LINK)"
    else
        GetKeyBtn.Text = "UNABLE TO AUTO-COPY"
    end
end)
