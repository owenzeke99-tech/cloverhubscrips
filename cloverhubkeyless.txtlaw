-- Configuration
local CORRECT_KEY = "CloverHubRyuunJsjsieowkwnkelekekdkdkdndndndkdk"
local GET_KEY_LINK = "https://link4m.net/OExKy33j"
local MAIN_SCRIPT_URL = "https://raw.githubusercontent.com/Ryuun0x/Clover/main/main.lua"
local SAVE_FILE_NAME = "CloverKeyData.json"
local KEY_DURATION = 86400 -- 24 hours (seconds)

local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui") or game.Players.LocalPlayer:WaitForChild("PlayerGui")

---------------------------------------------------------
-- LOGIC TẢI SCRIPT CHÍNH
---------------------------------------------------------
local function loadMainScript()
    print("[CLOVER HUB] Key hợp lệ! Đang tải Script chính...")
    task.spawn(function()
        local success, err = pcall(function()
            loadstring(game:HttpGet(MAIN_SCRIPT_URL))()
        end)
        if not success then
            warn("[CLOVER HUB] Lỗi không thể tải Script chính: " .. tostring(err))
        end
    end)
end

---------------------------------------------------------
-- LOGIC LƯU VÀ KIỂM TRA KEY (24 GIỜ)
---------------------------------------------------------

-- Hàm kiểm tra xem Key đã lưu còn dùng được không
local function isKeySavedAndValid()
    if readfile and isfile then
        local success, isExist = pcall(function() return isfile(SAVE_FILE_NAME) end)
        if success and isExist then
            local readSuccess, content = pcall(function() return readfile(SAVE_FILE_NAME) end)
            if readSuccess and content then
                local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(content) end)
                if decodeSuccess and data and data.Key == CORRECT_KEY then
                    local currentTime = os.time()
                    local elapsedTime = currentTime - (data.Timestamp or 0)
                    
                    if elapsedTime < KEY_DURATION then
                        return true -- Key còn hạn trong 24h
                    end
                end
            end
        end
    end
    return false
end

-- Hàm thực hiện lưu Key xuống máy
local function saveKeyData(key)
    if writefile then
        local data = {
            Key = key,
            Timestamp = os.time()
        }
        local success, err = pcall(function()
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(data))
        end)
        if success then
            print("[CLOVER HUB] Đã lưu key thành công vào tập tin: " .. SAVE_FILE_NAME)
        else
            warn("[CLOVER HUB] Không thể lưu file (Executor bị chặn quyền writefile): " .. tostring(err))
        end
    else
        warn("[CLOVER HUB] Executor của bạn không hỗ trợ hàm writefile!")
    end
end

-- TỰ ĐỘNG BỎ QUA MENU NẾU KEY ĐÃ LƯU CÒN HẠN
if isKeySavedAndValid() then
    print("[CLOVER HUB] Phát hiện Key cũ hợp lệ (trong 24h)! Tự động vào Script...")
    loadMainScript()
    return
end

